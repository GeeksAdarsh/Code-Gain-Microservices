FROM maven:3.9-eclipse-temurin-21-alpine AS build
WORKDIR /workspace

# Copy parent POM
COPY pom.xml ./services-pom.xml
# Copy shared-lib first and install it
COPY shared-lib/ ./shared-lib/

# Temporarily install parent and shared-lib
RUN cd shared-lib && mvn install -DskipTests -q -f pom.xml

# Now build the service itself
ARG SERVICE_DIR=.
COPY ${SERVICE_DIR}/pom.xml ./service-pom.xml
COPY ${SERVICE_DIR}/src ./src

RUN mvn package -DskipTests -q -f service-pom.xml

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /workspace/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]

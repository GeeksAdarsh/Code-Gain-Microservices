# Copy this file to terraform.tfvars and fill in your values.
# (terraform.tfvars is gitignored so your secrets are NOT committed.)

aws_region    = "eu-north-1"
instance_type = "t3.small" # or "t3.micro" for the lowest cost

# Paste the CONTENTS of your SSH public key so you can log in (optional but recommended).
# Generate one with:  ssh-keygen -t ed25519 -C "codecampus"
# then copy ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAA...your key... codecampus"

# Lock SSH to your own IP for safety (find it at https://ifconfig.me). Optional.
# allowed_ssh_cidr = "203.0.113.45/32"

# Secrets used inside the instance (change these!)
db_password = "ChangeMe_StrongPassword123"
# jwt_secret  = "base64-256-bit-secret"   # optional; a default is provided

# PRIVATE repo only: GitHub fine-grained PAT with Contents:read-only.
# Leave unset/empty if the repo is public.
# github_token = "github_pat_xxx"
